{
  "name": "JobTracker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:frontend:unit": "pnpm --filter client test:unit",
    "test:frontend:integration": "pnpm --filter client test:integration",
    "test:frontend": "pnpm test:frontend:unit && pnpm test:frontend:integration",
    "test:backend:unit": "pnpm --filter server test:unit",
    "test:backend:integration": "pnpm --filter server test:integration",
    "test:backend": "pnpm test:backend:unit && pnpm test:backend:integration",
    "test": "pnpm test:frontend && pnpm test:backend",
    "start-backend": "echo \"Starting backend...\" && docker compose up -d && pnpm --filter server dev",
    "start-frontend": "echo \"Starting backend...\" && pnpm --filter client dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "type": "module"
}
