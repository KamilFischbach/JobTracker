generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW_SCHEDULED
  OFFER
  REJECTED
}

// A registered account, or a temporary demo account (isDemo) that has no
// email or password and is deleted after expiresAt. A check constraint in the
// migration requires email and passwordHash for non-demo users.
model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  isDemo          Boolean          @default(false)
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  authTokens      AuthToken[]
  aiUsages        AiUsage[]
  applications    JobApplication[]

  @@index([expiresAt])
}

// A logged-in browser. The id is the SHA-256 hash of the cookie token, so a
// leaked database does not contain working sessions.
model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  SIGNUP
  PASSWORD_RESET
}

// A single-use link sent by email. The id is the SHA-256 hash of the token in
// the link. SIGNUP tokens carry the requested email and password hash: the
// User row is only created when the link is opened, so nobody can register
// someone else's address first and set its password. PASSWORD_RESET tokens
// belong to an existing user.
model AuthToken {
  id           String           @id
  purpose      AuthTokenPurpose
  email        String
  passwordHash String?
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())

  @@index([email])
  @@index([userId])
  @@index([expiresAt])
}

model JobApplication {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  jobTitle    String
  jobUrl      String?
  status      ApplicationStatus @default(SAVED)
  salaryMin   Decimal?          @db.Decimal(10, 2)
  salaryMax   Decimal?          @db.Decimal(10, 2)
  currency    String            @default("PLN")
  appliedDate DateTime?         @db.Date
  notes       String?           @db.Text
  emailEvents EmailEvent[]

  @@index([userId])
}

enum EmailCategory {
  APPLICATION_RECEIVED
  INTERVIEW_INVITATION
  REJECTION
  OFFER
  NOT_JOB_RELATED
}

enum EmailOutcome {
  UPDATED
  NO_CHANGE
  NEEDS_REVIEW
  NO_MATCH
  IGNORED
}

// One row per email processed by the n8n workflow. Email bodies are not stored.
model EmailEvent {
  id             String             @id @default(cuid())
  gmailMessageId String             @unique
  fromAddress    String
  subject        String
  receivedAt     DateTime
  category       EmailCategory
  companyName    String?
  jobTitle       String?
  confidence     Float
  reason         String?            @db.Text
  outcome        EmailOutcome
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus?
  applicationId  String?
  application    JobApplication?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())

  @@index([applicationId])
}

// One row per "Fill with AI" call that reached the LLM, for the daily limits.
// ipKey is an HMAC of the client address (IPv6 per /64), never the raw IP.
// Rows outlive their user (userId becomes null), so deleting a demo account
// does not reset the limit of its address.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  isDemo    Boolean
  ipKey     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ipKey, createdAt])
  @@index([createdAt])
}
