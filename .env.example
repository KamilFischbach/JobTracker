# Root .env: read by docker compose (compose.yaml and compose.prod.yaml).
# Copy to .env and fill in. Empty values mean "use the default".

# Database password. Use letters and digits only: it is also put into a URL.
POSTGRES_PASSWORD=

# --- Docker package (compose.prod.yaml) -------------------------------------

# Port on this machine: http://localhost:8080
APP_PORT=8080

# Account created on first start, so you can log in without the sign-up
# email. Password: 12+ characters. Changing it here later does not change an
# existing account's password (use Account > Change password).
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=

# Random secret for hashing visitor IPs in the AI limits (32+ characters).
IP_HASH_SECRET=

# "Fill with AI". Default: Ollama running on this machine (qwen2.5:7b).
#   Groq:   LLM_PROVIDER=groq and LLM_API_KEY=gsk_...
#   Ollama in Docker (--profile ai): LLM_BASE_URL=http://ollama:11434
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional. Sign-up emails go to the server log (docker compose logs server)
# unless Resend is configured.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Optional Cloudflare Turnstile on sign-up (both keys, or neither).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
