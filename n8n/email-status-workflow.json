    {
      "id": "06f7f10c-1533-5caf-9b4a-07bcc47ccb5e",
      "name": "Email + classification",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      }
    },
    {
      "id": "c17f52e3-d14a-5c94-b49e-1f80c9a0b4da",
      "name": "Build payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The Merge node puts each email next to the LLM's answer for it.\n// This builds the JobTracker webhook body. Anything unexpected from the model\n// falls back to safe values: an unknown category is ignored and a missing\n// confidence counts as 0, which the API sends to review.\nconst email = $json;\nconst ai = email.output ?? {};\nconst categories = [\n  'APPLICATION_RECEIVED',\n  'INTERVIEW_INVITATION',\n  'REJECTION',\n  'OFFER',\n  'NOT_JOB_RELATED',\n];\nconst confidence = Number(ai.confidence);\n\nreturn {\n  json: {\n    messageId: email.messageId,\n    from: email.from,\n    subject: email.subject,\n    receivedAt: email.receivedAt,\n    category: categories.includes(ai.category) ? ai.category : 'NOT_JOB_RELATED',\n    companyName: ai.companyName || null,\n    jobTitle: ai.jobTitle || null,\n    confidence: Number.isFinite(confidence) ? Math.min(1, Math.max(0, confidence)) : 0,\n    reason: ai.reason ? String(ai.reason).slice(0, 1000) : null,\n    // Not used by the API: they skip Gmail labels for samples and catch errors.\n    isSample: email.isSample,\n    classificationError: email.error ?? null,\n  },\n};"
      }
    },
    {
