# Web front of the Docker package (compose.prod.yaml): serves the built client
# and forwards /api/* to the API with the prefix removed, like the Vite proxy.
{
	admin off
}

:8080 {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		# Client-side routes (/login, /account, ...) all load index.html.
		try_files {path} /index.html
		file_server

		header {
			# __THEME_SCRIPT_HASH__ is replaced at build time with the hash of the
			# inline theme script in index.html (see client/Dockerfile).
			Content-Security-Policy "default-src 'self'; script-src 'self' __THEME_SCRIPT_HASH__ https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
			-Server
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
	}
}
